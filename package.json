{
  "name": "stickgame",
  "version": "0.0.0",
  "private": true,
  "description": "Precision Tether Platformer: a cross-platform momentum-action precision platformer built around Move, Jump and shot-defined Rope.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && npm run lint:deps",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs",
    "bundle:report": "node scripts/bundle-report.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run levels:validate && npm run lint && npm run format:check && npm run test && npm run build",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "cap open android",
    "cap:ios": "cap open ios",
    "device-lab:build": "vite build --mode device-lab",
    "cap:sync:device-lab": "npm run device-lab:build && cap sync",
    "levels:validate": "npm run levels:compile-schema -- --check && node scripts/validate-levels.mjs",
    "prebuild": "npm run levels:validate",
    "levels:compile-schema": "node scripts/compile-level-schema.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.3",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.3",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "dependency-cruiser": "18.5.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "planck": "1.4.2",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "5.0.3",
    "ajv": "8.17.1"
  }
}
